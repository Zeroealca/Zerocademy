# Copy to .env at the repository root: cp .env.example .env
# Docker Compose reads variables from this file.

# -----------------------------------------------------------------------------
# PostgreSQL (service: postgres)
# -----------------------------------------------------------------------------
POSTGRES_USER=zerocademy
POSTGRES_PASSWORD=zerocademy_secret
POSTGRES_DB=zerocademy_db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend (service: backend) — host port 3001
# -----------------------------------------------------------------------------
BACKEND_PORT=3001
# Internal Docker hostname for Postgres (do not use localhost inside containers)
DATABASE_URL=postgresql://zerocademy:zerocademy_secret@postgres:5432/zerocademy_db?schema=public
JWT_SECRET=change-me-in-production-use-openssl-rand
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-use-openssl-rand
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
SEED_ADMIN_EMAIL=admin@zerocademy.edu
SEED_ADMIN_PASSWORD=ChangeMe123!
# Set to true to expose /api/docs in production (default: off when NODE_ENV=production)
SWAGGER_ENABLED=

# -----------------------------------------------------------------------------
# Frontend (service: frontend) — host port 3000
# Browser-facing API URL (host machine, not Docker service name)
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# pgAdmin (service: pgadmin) — host port 5050
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
