# Copy to .env at the repository root: cp .env.example .env
# Docker Compose reads variables from this file.

# -----------------------------------------------------------------------------
# PostgreSQL (service: postgres)
# -----------------------------------------------------------------------------
POSTGRES_USER=zerocademy
POSTGRES_PASSWORD=zerocademy_secret
POSTGRES_DB=zerocademy_db
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend (service: backend) — host port 3001
# -----------------------------------------------------------------------------
BACKEND_PORT=3001
# Internal Docker hostname for Postgres (do not use localhost inside containers)
DATABASE_URL=postgresql://zerocademy:zerocademy_secret@postgres:5432/zerocademy_db?schema=public
JWT_SECRET=change-me-in-production-use-openssl-rand
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-use-openssl-rand
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Comma-separated list. In development, private LAN IPs on any port are also allowed.
# When sharing over LAN, you can also add the explicit origin, e.g.:
# CORS_ORIGIN=http://localhost:3000,http://192.168.0.21:3000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
SEED_ADMIN_EMAIL=admin@zerocademy.edu
SEED_ADMIN_PASSWORD=ChangeMe123!
# Skip demo institution (catalog + SUPER_ADMIN only)
# SEED_SKIP_DEMO=true
# Run prisma seed on backend container start (set false to skip)
RUN_PRISMA_SEED=true
# Set to true to expose /api/docs in production (default: off when NODE_ENV=production)
SWAGGER_ENABLED=

# Host LAN IP of the machine running the stack (other PCs open http://LAN_HOST:3000).
# Also used by Next.js allowedDevOrigins so /_next scripts work from the network.
LAN_HOST=192.168.0.21
# Optional extra hosts for Next.js dev (comma-separated), e.g. another NIC or hostname
# ALLOWED_DEV_ORIGINS=192.168.0.21,my-mac.local

# -----------------------------------------------------------------------------
# Frontend (service: frontend) — host port 3000
# Browser uses same-origin /v1 via Next.js proxy (LAN-friendly). Prefer localhost
# here for local tools; do not point this at a LAN IP unless you intentionally
# bypass the proxy.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Next.js server-side proxy target (Docker: backend service; local: 127.0.0.1)
# INTERNAL_API_URL=http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# pgAdmin (service: pgadmin) — host port 5050
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
