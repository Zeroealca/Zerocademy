// Prisma schema — persistence layer for BackendZerocademy.
// DATABASE_URL is injected by Docker Compose / .env (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: use the direct (non-pooler) URL for migrate/introspect.
  // Local Docker: set the same value as DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// RBAC — system roles (single role per user; permissions layer is future work)
// ---------------------------------------------------------------------------
enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  REPRESENTATIVE
}

// ---------------------------------------------------------------------------
// Authentication account — credentials and RBAC role only (no academic fields)
// ---------------------------------------------------------------------------
model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                      Role                   @default(STUDENT)
  isActive                  Boolean                @default(true)
  selectedAcademicPeriodId  String?
  deletedAt                 DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  refreshTokens         RefreshToken[]
  studentProfile        StudentProfile?
  teacherProfile        TeacherProfile?
  representativeProfile RepresentativeProfile?
  institutionMemberships     InstitutionMembership[]
  academicPeriodTransitions  AcademicPeriodTransition[]
  selectedAcademicPeriod     AcademicPeriod?            @relation("UserSelectedPeriod", fields: [selectedAcademicPeriodId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([selectedAcademicPeriodId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Educational institutions — root owner of the academic domain
// ---------------------------------------------------------------------------
enum InstitutionRegion {
  COSTA
  SIERRA
  AMAZONIA
  GALAPAGOS
}

/// Institution-scoped role for admins and teachers (extensible for multi-role later).
enum InstitutionMembershipRole {
  ADMIN
  TEACHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
  FAILED
  TRANSFERRED
}

model Institution {
  id             String             @id @default(uuid())
  name           String
  code           String             @unique
  email          String?
  phone          String?
  address        String?
  region         InstitutionRegion?
  regime         AcademicRegime?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  isActive               Boolean            @default(true)
  activeAcademicPeriodId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  activeAcademicPeriod   AcademicPeriod?            @relation("InstitutionActivePeriod", fields: [activeAcademicPeriodId], references: [id], onDelete: SetNull)
  studentProfiles        StudentProfile[]
  teacherProfiles        TeacherProfile[]
  representativeProfiles RepresentativeProfile[]
  memberships            InstitutionMembership[]
  academicLevels         AcademicLevel[]
  gradeLevels            GradeLevel[]
  academicPeriods        AcademicPeriod[]
  courses                Course[]
  subjects               Subject[]
  teacherAssignments     TeacherAssignment[]
  periodTransitions             AcademicPeriodTransition[]
  gradingSchemes                GradingScheme[]
  evaluationTerms               EvaluationTerm[]
  assessmentCategories          AssessmentCategory[]
  academicEvaluationConfig      InstitutionAcademicConfiguration?
  assessments                   Assessment[]

  @@index([isActive])
  @@index([activeAcademicPeriodId])
  @@index([region])
  @@index([regime])
  @@map("institutions")
}

model InstitutionMembership {
  id            String                   @id @default(uuid())
  institutionId String
  userId        String
  role          InstitutionMembershipRole
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  institution   Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([institutionId])
  @@index([userId])
  @@index([institutionId, role])
  @@index([isActive])
  @@map("institution_memberships")
}

/// Permanent student entity (1:1 with User account role STUDENT).
model StudentProfile {
  id               String       @id @default(uuid())
  registrationNumber String     @unique @default(dbgenerated("('MAT-'::text || (gen_random_uuid())::text)"))
  userId           String       @unique
  institutionId    String?
  nationalId       String?      @unique
  birthDate        DateTime?    @db.Date
  gender           Gender?
  phone            String?
  address          String?
  emergencyContact String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution      Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]

  @@index([institutionId])
  @@index([isActive])
  @@index([nationalId])
  @@map("student_profiles")
}

model TeacherProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  institutionId      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  teacherAssignments TeacherAssignment[]

  @@index([institutionId])
  @@map("teacher_profiles")
}

model RepresentativeProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  institutionId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@map("representative_profiles")
}

// ---------------------------------------------------------------------------
// Academic calendar — Ecuadorian regimes (Costa/Galápagos vs Sierra/Amazonía)
// ---------------------------------------------------------------------------
enum AcademicRegime {
  COSTA_GALAPAGOS
  SIERRA_AMAZONIA
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

model AcademicPeriod {
  id            String               @id @default(uuid())
  name          String
  institutionId String?
  regime        AcademicRegime
  startDate     DateTime             @db.Date
  endDate       DateTime             @db.Date
  isActive      Boolean              @default(false)
  status        AcademicPeriodStatus @default(PLANNED)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  institution            Institution?           @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  activeForInstitutions  Institution[]          @relation("InstitutionActivePeriod")
  terms                  AcademicTerm[]
  courses                Course[]
  teacherAssignments     TeacherAssignment[]
  transitionsFrom        AcademicPeriodTransition[] @relation("TransitionFromPeriod")
  transitionsTo          AcademicPeriodTransition[] @relation("TransitionToPeriod")
  selectedByUsers        User[]                     @relation("UserSelectedPeriod")
  enrollments            Enrollment[]
  evaluationTerms        EvaluationTerm[]
  evaluationConfigActive InstitutionAcademicConfiguration[] @relation("ConfigActivePeriod")
  assessments            Assessment[]

  @@index([institutionId])
  @@index([regime])
  @@index([status])
  @@index([isActive])
  @@index([regime, status])
  @@index([institutionId, regime, status])
  @@index([startDate, endDate])
  @@map("academic_periods")
}

model AcademicTerm {
  id               String         @id @default(uuid())
  name             String
  order            Int
  startDate        DateTime       @db.Date
  endDate          DateTime       @db.Date
  academicPeriodId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  assessments      Assessment[]

  @@unique([academicPeriodId, order])
  @@index([academicPeriodId])
  @@map("academic_terms")
}

// ---------------------------------------------------------------------------
// Academic structure — reusable levels/grades; period-scoped classroom courses
// ---------------------------------------------------------------------------
model AcademicLevel {
  id             String        @id @default(uuid())
  name           String
  code           String
  order          Int
  description    String?
  institutionId  String?
  isSystem       Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  institution    Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  gradeLevels    GradeLevel[]

  @@index([institutionId])
  @@index([isActive])
  @@index([order])
  @@index([isSystem])
  @@map("academic_levels")
}

model GradeLevel {
  id              String        @id @default(uuid())
  name            String
  code            String
  order           Int
  description     String?
  academicLevelId String
  institutionId   String?
  isSystem        Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)
  institution        Institution?         @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  courses            Course[]
  subjectGradeLevels SubjectGradeLevel[]

  @@unique([academicLevelId, code])
  @@index([academicLevelId])
  @@index([institutionId])
  @@index([isActive])
  @@index([order])
  @@map("grade_levels")
}

/// Classroom / parallel group offering for a grade within an academic period.
model Course {
  id               String         @id @default(uuid())
  name             String
  section          String
  capacity         Int?
  institutionId    String?
  academicPeriodId String
  gradeLevelId     String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  institution        Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  academicPeriod     AcademicPeriod      @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  teacherAssignments TeacherAssignment[]
  enrollments        Enrollment[]

  @@unique([academicPeriodId, gradeLevelId, section])
  @@index([institutionId])
  @@index([academicPeriodId])
  @@index([gradeLevelId])
  @@index([isActive])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// Academic catalog — reusable subjects and teacher assignments
// ---------------------------------------------------------------------------
model Subject {
  id                 String              @id @default(uuid())
  name               String
  code               String
  description        String?
  institutionId      String?
  isSystem           Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  institution        Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  gradeLevelLinks    SubjectGradeLevel[]
  teacherAssignments TeacherAssignment[]
  assessments        Assessment[]

  @@index([institutionId])
  @@index([isActive])
  @@index([isSystem])
  @@map("subjects")
}

/// Links reusable subjects to grade levels (curriculum scope).
model SubjectGradeLevel {
  id           String     @id @default(uuid())
  subjectId    String
  gradeLevelId String
  createdAt    DateTime   @default(now())
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)

  @@unique([subjectId, gradeLevelId])
  @@index([subjectId])
  @@index([gradeLevelId])
  @@map("subject_grade_levels")
}

/// Assigns a teacher to teach a subject in a classroom course for an academic period.
model TeacherAssignment {
  id               String         @id @default(uuid())
  institutionId    String?
  teacherId        String
  subjectId        String
  courseId         String
  academicPeriodId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  institution    Institution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  teacher          TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  assessments      Assessment[]

  @@unique([teacherId, subjectId, courseId, academicPeriodId])
  @@unique([subjectId, courseId, academicPeriodId], map: "teacher_assignments_subject_course_period_key")
  @@index([institutionId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([courseId])
  @@index([academicPeriodId])
  @@index([academicPeriodId, teacherId])
  @@map("teacher_assignments")
}

/// Student enrollment in a classroom course for an academic period (historical status tracked).
model Enrollment {
  id               String           @id @default(uuid())
  studentId        String
  courseId         String
  academicPeriodId String
  enrollmentDate   DateTime         @db.Date
  status           EnrollmentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  student          StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicPeriod   AcademicPeriod   @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  grades           Grade[]

  @@unique([studentId, courseId, academicPeriodId])
  @@index([studentId])
  @@index([courseId])
  @@index([academicPeriodId])
  @@index([status])
  @@index([academicPeriodId, courseId])
  @@map("enrollments")
}

/// Audit record for academic year transitions — historical data is never mutated.
model AcademicPeriodTransition {
  id                   String      @id @default(uuid())
  institutionId        String
  fromAcademicPeriodId String
  toAcademicPeriodId   String
  executedById         String
  copiedCourses        Boolean     @default(false)
  copiedAssignments    Boolean     @default(false)
  copiedStructures     Boolean     @default(false)
  copiedTerms          Boolean     @default(false)
  createdAt            DateTime    @default(now())
  institution          Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fromPeriod           AcademicPeriod @relation("TransitionFromPeriod", fields: [fromAcademicPeriodId], references: [id], onDelete: Restrict)
  toPeriod             AcademicPeriod @relation("TransitionToPeriod", fields: [toAcademicPeriodId], references: [id], onDelete: Restrict)
  executedBy           User          @relation(fields: [executedById], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([fromAcademicPeriodId])
  @@index([toAcademicPeriodId])
  @@index([executedById])
  @@index([createdAt])
  @@map("academic_period_transitions")
}

// ---------------------------------------------------------------------------
// Academic evaluation configuration — grading engine foundation
// ---------------------------------------------------------------------------
enum RoundingStrategy {
  ROUND_HALF_UP
  ROUND_DOWN
  ROUND_UP
  TRUNCATE
}

/// Numeric grading scale definition (institution-owned or global template).
model GradingScheme {
  id            String   @id @default(uuid())
  institutionId String?
  name          String
  minScore      Decimal  @db.Decimal(6, 2)
  maxScore      Decimal  @db.Decimal(6, 2)
  passingScore  Decimal  @db.Decimal(6, 2)
  decimalPlaces Int      @default(2)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution    Institution?                       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  gradeScales       GradeScale[]
  configurations    InstitutionAcademicConfiguration[]
  platformConfig    PlatformAcademicEvaluationConfig?
  gradeSnapshots    Grade[]

  @@index([institutionId])
  @@index([institutionId, isDefault])
  @@index([isActive])
  @@map("grading_schemes")
}

/// Grading period with weighting — distinct from calendar AcademicTerm (quimesters).
model EvaluationTerm {
  id               String    @id @default(uuid())
  institutionId    String
  academicPeriodId String
  name             String
  order            Int
  weight           Decimal   @db.Decimal(5, 2)
  startDate        DateTime? @db.Date
  endDate          DateTime? @db.Date
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)

  @@unique([institutionId, academicPeriodId, order])
  @@unique([institutionId, academicPeriodId, name])
  @@index([institutionId])
  @@index([academicPeriodId])
  @@index([isActive])
  @@map("evaluation_terms")
}

/// Assessment category with weight for grade composition (e.g. exams, projects).
model AssessmentCategory {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  weight        Decimal  @db.Decimal(5, 2)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([isActive])
  @@map("assessment_categories")
}

/// Qualitative equivalency band within a grading scheme.
model GradeScale {
  id              String   @id @default(uuid())
  gradingSchemeId String
  code            String
  description     String
  minValue        Decimal  @db.Decimal(6, 2)
  maxValue        Decimal  @db.Decimal(6, 2)
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gradingScheme GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)

  @@unique([gradingSchemeId, code])
  @@unique([gradingSchemeId, order])
  @@index([gradingSchemeId])
  @@map("grade_scales")
}

/// Institution-level active evaluation configuration snapshot.
model InstitutionAcademicConfiguration {
  id                     String           @id @default(uuid())
  institutionId          String           @unique
  gradingSchemeId        String
  activeAcademicPeriodId String?
  roundingStrategy       RoundingStrategy @default(ROUND_HALF_UP)
  decimalPlaces          Int              @default(2)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  institution          Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  gradingScheme        GradingScheme   @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)
  activeAcademicPeriod AcademicPeriod? @relation("ConfigActivePeriod", fields: [activeAcademicPeriodId], references: [id], onDelete: SetNull)

  @@index([gradingSchemeId])
  @@index([activeAcademicPeriodId])
  @@map("institution_academic_configurations")
}

/// Singleton platform defaults applied to all institutions unless customized.
model PlatformAcademicEvaluationConfig {
  id               String           @id @default("platform-evaluation-defaults")
  gradingSchemeId  String           @unique
  roundingStrategy RoundingStrategy @default(ROUND_HALF_UP)
  decimalPlaces    Int              @default(2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  gradingScheme GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)

  @@map("platform_academic_evaluation_config")
}

/// Platform-wide assessment category template (copied per institution on apply).
model AssessmentCategoryTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  weight      Decimal  @db.Decimal(5, 2)
  description String?
  order       Int      @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("assessment_category_templates")
}

/// Platform-wide evaluation term template (copied per institution period on apply).
model EvaluationTermTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  order       Int      @unique
  weight      Decimal  @db.Decimal(5, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("evaluation_term_templates")
}

// ---------------------------------------------------------------------------
// Grades — assessments and grade entries (phase 1)
// ---------------------------------------------------------------------------

/// Teacher-created evaluation instrument scoped to an assignment and calendar term.
model Assessment {
  id                   String   @id @default(uuid())
  institutionId        String
  academicPeriodId     String
  academicTermId       String
  subjectId            String
  teacherAssignmentId  String
  assessmentCategoryId String
  title                String
  description          String?
  maxScore             Decimal  @db.Decimal(6, 2)
  weight               Decimal  @db.Decimal(5, 2)
  assessmentDate       DateTime @db.Date
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  institution        Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicPeriod     AcademicPeriod     @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  academicTerm       AcademicTerm       @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherAssignment  TeacherAssignment  @relation(fields: [teacherAssignmentId], references: [id], onDelete: Restrict)
  assessmentCategory AssessmentCategory @relation(fields: [assessmentCategoryId], references: [id], onDelete: Restrict)
  grades             Grade[]

  @@index([institutionId])
  @@index([academicPeriodId])
  @@index([academicTermId])
  @@index([subjectId])
  @@index([teacherAssignmentId])
  @@index([assessmentCategoryId])
  @@index([academicPeriodId, teacherAssignmentId])
  @@index([institutionId, academicPeriodId, academicTermId])
  @@map("assessments")
}

/// Score recorded for a student enrollment on a specific assessment.
model Grade {
  id              String   @id @default(uuid())
  assessmentId    String
  enrollmentId    String
  score           Decimal  @db.Decimal(6, 2)
  observations    String?
  gradingSchemeId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assessment    Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  enrollment    Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  gradingScheme GradingScheme? @relation(fields: [gradingSchemeId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, enrollmentId])
  @@index([assessmentId])
  @@index([enrollmentId])
  @@index([gradingSchemeId])
  @@map("grades")
}

// Bootstrap health probe — kept for infrastructure checks.
model HealthCheck {
  id        Int      @id @default(1)
  checkedAt DateTime @default(now()) @updatedAt
}
