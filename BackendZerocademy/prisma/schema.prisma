// Prisma schema — persistence layer for BackendZerocademy.
// DATABASE_URL is injected by Docker Compose / .env (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: use the direct (non-pooler) URL for migrate/introspect.
  // Local Docker: set the same value as DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// RBAC — system roles (single role per user; permission enforcement remains future work)
// ---------------------------------------------------------------------------
enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  REPRESENTATIVE
}

/// System-owned mirror of the code-defined permission catalog. These rows are
/// reference data only; they are not consulted by production authorization yet.
model Permission {
  id                     String                        @id @default(uuid())
  key                    String                        @unique
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  roleAllowedPermissions RoleAllowedPermission[]
  profilePermissions     PermissionProfilePermission[]

  @@map("permissions")
}

/// System-owned live permission composition. Optional membership assignment is
/// persistence-only foundation; it is not consulted by production authorization yet.
model PermissionProfile {
  id                     String                        @id @default(uuid())
  key                    String                        @unique
  name                   String
  role                   Role
  isSystem               Boolean                       @default(true)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  permissions            PermissionProfilePermission[]
  institutionMemberships InstitutionMembership[]

  @@index([role])
  @@index([isSystem])
  @@map("permission_profiles")
}

/// Current live composition of a permission profile.
model PermissionProfilePermission {
  permissionProfileId String
  permissionId        String
  createdAt           DateTime          @default(now())
  permissionProfile   PermissionProfile @relation(fields: [permissionProfileId], references: [id], onDelete: Restrict)
  permission          Permission        @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([permissionProfileId, permissionId])
  @@index([permissionProfileId])
  @@index([permissionId])
  @@map("permission_profile_permissions")
}

/// Current maximum permission boundary for a system Role, synchronized from
/// ROLE_ALLOWED_PERMISSIONS. It is not an individual user permission grant.
model RoleAllowedPermission {
  role         Role
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("role_allowed_permissions")
}

enum RepresentativeRelationshipType {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  GRANDPARENT
  OTHER
}

// ---------------------------------------------------------------------------
// Authentication account — credentials and RBAC role only (no academic fields)
// ---------------------------------------------------------------------------
model User {
  id                                String                         @id @default(uuid())
  email                             String                         @unique
  passwordHash                      String
  firstName                         String
  lastName                          String
  role                              Role                           @default(STUDENT)
  isActive                          Boolean                        @default(true)
  selectedAcademicPeriodId          String?
  deletedAt                         DateTime?
  createdAt                         DateTime                       @default(now())
  updatedAt                         DateTime                       @updatedAt
  refreshTokens                     RefreshToken[]
  studentProfile                    StudentProfile?
  teacherProfile                    TeacherProfile?
  representativeProfile             RepresentativeProfile?
  institutionMemberships            InstitutionMembership[]
  academicPeriodTransitions         AcademicPeriodTransition[]
  attendanceRecordsRecorded         AttendanceRecord[]             @relation("AttendanceRecordedBy")
  classSessionAttendanceRecorded    ClassSessionAttendanceRecord[] @relation("ClassSessionAttendanceRecordedBy")
  attendanceJustificationsSubmitted AttendanceJustification[]      @relation("AttendanceJustificationSubmittedBy")
  attendanceJustificationsReviewed  AttendanceJustification[]      @relation("AttendanceJustificationReviewedBy")
  academicPlansCreated              AcademicPlan[]                 @relation("AcademicPlanCreatedBy")
  academicPlansPublished            AcademicPlan[]                 @relation("AcademicPlanPublishedBy")
  representativeStudentRelations    RepresentativeStudent[]        @relation("RepresentativeStudentRepresentative")
  gradeAuditEvents                  GradeAuditEvent[]              @relation("GradeAuditActor")
  assessmentsPublished              Assessment[]                   @relation("AssessmentPublishedBy")
  timetablesPublished               Timetable[]                    @relation("TimetablePublishedBy")
  selectedAcademicPeriod            AcademicPeriod?                @relation("UserSelectedPeriod", fields: [selectedAcademicPeriodId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([selectedAcademicPeriodId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Educational institutions — root owner of the academic domain
// ---------------------------------------------------------------------------
enum InstitutionRegion {
  COSTA
  SIERRA
  AMAZONIA
  GALAPAGOS
}

/// Institution-scoped role for admins and teachers (extensible for multi-role later).
enum InstitutionMembershipRole {
  ADMIN
  TEACHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
  FAILED
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceJustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AcademicPlanStatus {
  DRAFT
  PUBLISHED
}

/// Operational state of an actual teaching occurrence, independent of AcademicPlan publication.
enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ScheduleBlockKind {
  TEACHING
  BREAK
  NON_TEACHING
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
}

model Institution {
  id                     String             @id @default(uuid())
  name                   String
  code                   String             @unique
  email                  String?
  phone                  String?
  address                String?
  region                 InstitutionRegion?
  regime                 AcademicRegime?
  logoUrl                String?
  primaryColor           String?
  secondaryColor         String?
  isActive               Boolean            @default(true)
  activeAcademicPeriodId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  activeAcademicPeriod     AcademicPeriod?                   @relation("InstitutionActivePeriod", fields: [activeAcademicPeriodId], references: [id], onDelete: SetNull)
  studentProfiles          StudentProfile[]
  teacherProfiles          TeacherProfile[]
  representativeProfiles   RepresentativeProfile[]
  memberships              InstitutionMembership[]
  academicLevels           AcademicLevel[]
  gradeLevels              GradeLevel[]
  subLevels                SubLevel[]
  academicPeriods          AcademicPeriod[]
  courses                  Course[]
  subjects                 Subject[]
  teacherAssignments       TeacherAssignment[]
  periodTransitions        AcademicPeriodTransition[]
  gradingSchemes           GradingScheme[]
  evaluationTerms          EvaluationTerm[]
  assessmentCategories     AssessmentCategory[]
  academicEvaluationConfig InstitutionAcademicConfiguration?
  assessments              Assessment[]
  attendanceRecords        AttendanceRecord[]
  periodScheduleStructures PeriodScheduleStructure[]
  timetables               Timetable[]

  @@index([isActive])
  @@index([activeAcademicPeriodId])
  @@index([region])
  @@index([regime])
  @@map("institutions")
}

model InstitutionMembership {
  id                  String                    @id @default(uuid())
  institutionId       String
  userId              String
  role                InstitutionMembershipRole
  isActive            Boolean                   @default(true)
  /// Optional non-authoritative PermissionProfile assignment (at most one).
  permissionProfileId String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  institution         Institution               @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionProfile   PermissionProfile?        @relation(fields: [permissionProfileId], references: [id], onDelete: Restrict)

  @@unique([institutionId, userId])
  @@index([institutionId])
  @@index([userId])
  @@index([institutionId, role])
  @@index([isActive])
  @@index([permissionProfileId])
  @@map("institution_memberships")
}

/// Permanent student entity (1:1 with User account role STUDENT).
model StudentProfile {
  id                             String                  @id @default(uuid())
  registrationNumber             String                  @unique @default(dbgenerated("('MAT-'::text || (gen_random_uuid())::text)"))
  userId                         String                  @unique
  institutionId                  String?
  nationalId                     String?                 @unique
  birthDate                      DateTime?               @db.Date
  gender                         Gender?
  phone                          String?
  address                        String?
  emergencyContact               String?
  isActive                       Boolean                 @default(true)
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  user                           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution                    Institution?            @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  enrollments                    Enrollment[]
  representativeStudentRelations RepresentativeStudent[]

  @@index([institutionId])
  @@index([isActive])
  @@index([nationalId])
  @@map("student_profiles")
}

model TeacherProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  institutionId      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution        Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]

  @@index([institutionId])
  @@map("teacher_profiles")
}

model RepresentativeProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  institutionId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@map("representative_profiles")
}

/// Authorized, historical relationship between a representative account and a student.
model RepresentativeStudent {
  id                   String                         @id @default(uuid())
  representativeUserId String
  studentId            String
  relationshipType     RepresentativeRelationshipType
  isPrimary            Boolean                        @default(false)
  isActive             Boolean                        @default(true)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  representativeUser   User                           @relation("RepresentativeStudentRepresentative", fields: [representativeUserId], references: [id], onDelete: Restrict)
  student              StudentProfile                 @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([representativeUserId, studentId])
  @@index([representativeUserId, isActive])
  @@index([studentId, isActive])
  @@map("representative_students")
}

// ---------------------------------------------------------------------------
// Academic calendar — Ecuadorian regimes (Costa/Galápagos vs Sierra/Amazonía)
// ---------------------------------------------------------------------------
enum AcademicRegime {
  COSTA_GALAPAGOS
  SIERRA_AMAZONIA
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

model AcademicPeriod {
  id                       String                             @id @default(uuid())
  name                     String
  institutionId            String?
  regime                   AcademicRegime
  startDate                DateTime                           @db.Date
  endDate                  DateTime                           @db.Date
  isActive                 Boolean                            @default(false)
  status                   AcademicPeriodStatus               @default(PLANNED)
  createdAt                DateTime                           @default(now())
  updatedAt                DateTime                           @updatedAt
  institution              Institution?                       @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  activeForInstitutions    Institution[]                      @relation("InstitutionActivePeriod")
  terms                    AcademicTerm[]
  courses                  Course[]
  teacherAssignments       TeacherAssignment[]
  transitionsFrom          AcademicPeriodTransition[]         @relation("TransitionFromPeriod")
  transitionsTo            AcademicPeriodTransition[]         @relation("TransitionToPeriod")
  selectedByUsers          User[]                             @relation("UserSelectedPeriod")
  enrollments              Enrollment[]
  evaluationTerms          EvaluationTerm[]
  evaluationConfigActive   InstitutionAcademicConfiguration[] @relation("ConfigActivePeriod")
  assessments              Assessment[]
  attendanceRecords        AttendanceRecord[]
  periodScheduleStructures PeriodScheduleStructure[]
  timetables               Timetable[]

  @@index([institutionId])
  @@index([regime])
  @@index([status])
  @@index([isActive])
  @@index([regime, status])
  @@index([institutionId, regime, status])
  @@index([startDate, endDate])
  @@map("academic_periods")
}

model AcademicTerm {
  id               String         @id @default(uuid())
  name             String
  order            Int
  startDate        DateTime       @db.Date
  endDate          DateTime       @db.Date
  academicPeriodId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  assessments      Assessment[]
  academicPlans    AcademicPlan[]

  @@unique([academicPeriodId, order])
  @@index([academicPeriodId])
  @@map("academic_terms")
}

// ---------------------------------------------------------------------------
// Academic structure — reusable levels/grades; period-scoped classroom courses
// ---------------------------------------------------------------------------
model AcademicLevel {
  id            String       @id @default(uuid())
  name          String
  code          String
  order         Int
  description   String?
  institutionId String?
  isSystem      Boolean      @default(false)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  gradeLevels   GradeLevel[]
  subLevels     SubLevel[]

  @@index([institutionId])
  @@index([isActive])
  @@index([order])
  @@index([isSystem])
  @@map("academic_levels")
}

model GradeLevel {
  id                 String              @id @default(uuid())
  name               String
  code               String
  order              Int
  description        String?
  academicLevelId    String
  subLevelId         String?
  institutionId      String?
  isSystem           Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  academicLevel      AcademicLevel       @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)
  subLevel           SubLevel?           @relation(fields: [subLevelId], references: [id], onDelete: Restrict)
  institution        Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  courses            Course[]
  subjectGradeLevels SubjectGradeLevel[]

  @@unique([academicLevelId, code])
  @@index([academicLevelId])
  @@index([subLevelId])
  @@index([institutionId])
  @@index([isActive])
  @@index([order])
  @@map("grade_levels")
}

/// Reusable subdivision within an academic level (for example, EGB Media).
model SubLevel {
  id              String        @id @default(uuid())
  name            String
  code            String
  order           Int
  description     String?
  academicLevelId String
  institutionId   String?
  isSystem        Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)
  institution     Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  courses         Course[]
  gradeLevels     GradeLevel[]

  @@unique([academicLevelId, code])
  @@index([academicLevelId])
  @@index([institutionId])
  @@index([isActive])
  @@index([order])
  @@map("sub_levels")
}

/// Classroom / parallel group offering for a grade within an academic period.
model Course {
  id                 String              @id @default(uuid())
  name               String
  section            String
  capacity           Int?
  institutionId      String?
  academicPeriodId   String
  gradeLevelId       String
  subLevelId         String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  institution        Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  academicPeriod     AcademicPeriod      @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  subLevel           SubLevel?           @relation(fields: [subLevelId], references: [id], onDelete: Restrict)
  teacherAssignments TeacherAssignment[]
  enrollments        Enrollment[]
  attendanceRecords  AttendanceRecord[]
  timetableSlots     TimetableSlot[]

  @@unique([academicPeriodId, gradeLevelId, section])
  @@index([institutionId])
  @@index([academicPeriodId])
  @@index([gradeLevelId])
  @@index([subLevelId])
  @@index([isActive])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// Academic catalog — reusable subjects and teacher assignments
// ---------------------------------------------------------------------------
model Subject {
  id                 String              @id @default(uuid())
  name               String
  code               String
  description        String?
  institutionId      String?
  isSystem           Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  institution        Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  gradeLevelLinks    SubjectGradeLevel[]
  teacherAssignments TeacherAssignment[]
  assessments        Assessment[]

  @@index([institutionId])
  @@index([isActive])
  @@index([isSystem])
  @@map("subjects")
}

/// Links reusable subjects to grade levels (curriculum scope).
model SubjectGradeLevel {
  id           String     @id @default(uuid())
  subjectId    String
  gradeLevelId String
  createdAt    DateTime   @default(now())
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)

  @@unique([subjectId, gradeLevelId])
  @@index([subjectId])
  @@index([gradeLevelId])
  @@map("subject_grade_levels")
}

/// Assigns a teacher to teach a subject in a classroom course for an academic period.
model TeacherAssignment {
  id               String          @id @default(uuid())
  institutionId    String?
  teacherId        String
  subjectId        String
  courseId         String
  academicPeriodId String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  institution      Institution?    @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  teacher          TeacherProfile  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject          Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicPeriod   AcademicPeriod  @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  assessments      Assessment[]
  academicPlans    AcademicPlan[]
  classSessions    ClassSession[]
  teachingLoad     TeachingLoad?
  timetableSlots   TimetableSlot[]

  @@unique([teacherId, subjectId, courseId, academicPeriodId])
  @@unique([subjectId, courseId, academicPeriodId], map: "teacher_assignments_subject_course_period_key")
  @@index([institutionId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([courseId])
  @@index([academicPeriodId])
  @@index([academicPeriodId, teacherId])
  @@map("teacher_assignments")
}

/// Period-specific weekly calendar configuration for one institution.
model PeriodScheduleStructure {
  id               String          @id @default(uuid())
  institutionId    String
  academicPeriodId String
  enabledWeekdays  Weekday[]       @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  institution      Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicPeriod   AcademicPeriod  @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  scheduleBlocks   ScheduleBlock[]

  @@unique([institutionId, academicPeriodId])
  @@index([institutionId])
  @@index([academicPeriodId])
  @@map("period_schedule_structures")
}

/// Ordered time block within a period schedule structure.
model ScheduleBlock {
  id                        String                  @id @default(uuid())
  periodScheduleStructureId String
  position                  Int
  name                      String?                 @db.VarChar(120)
  startTime                 DateTime                @db.Time(0)
  endTime                   DateTime                @db.Time(0)
  kind                      ScheduleBlockKind
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  periodScheduleStructure   PeriodScheduleStructure @relation(fields: [periodScheduleStructureId], references: [id], onDelete: Cascade)
  timetableSlots            TimetableSlot[]

  @@unique([periodScheduleStructureId, position])
  @@index([periodScheduleStructureId])
  @@index([kind])
  @@map("schedule_blocks")
}

/// Required weekly teaching periods for one staffed teacher assignment.
model TeachingLoad {
  id                  String            @id @default(uuid())
  teacherAssignmentId String            @unique
  weeklyPeriods       Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  teacherAssignment   TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)

  @@map("teaching_loads")
}

/// One weekly timetable aggregate per institution and academic period.
model Timetable {
  id                String          @id @default(uuid())
  institutionId     String
  academicPeriodId  String
  status            TimetableStatus @default(DRAFT)
  version           Int             @default(1)
  publishedAt       DateTime?
  publishedByUserId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  institution       Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicPeriod    AcademicPeriod  @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  publishedByUser   User?           @relation("TimetablePublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  slots             TimetableSlot[]

  @@unique([institutionId, academicPeriodId])
  @@index([institutionId])
  @@index([academicPeriodId])
  @@index([status])
  @@index([publishedByUserId])
  @@map("timetables")
}

/// A recurring TeacherAssignment placement in a teaching block on one weekday.
model TimetableSlot {
  id                  String            @id @default(uuid())
  timetableId         String
  teacherAssignmentId String
  scheduleBlockId     String
  dayOfWeek           Weekday
  teacherId           String
  courseId            String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  timetable           Timetable         @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  teacherAssignment   TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Restrict)
  scheduleBlock       ScheduleBlock     @relation(fields: [scheduleBlockId], references: [id], onDelete: Restrict)
  teacher             TeacherProfile    @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([timetableId, dayOfWeek, scheduleBlockId, teacherId])
  @@unique([timetableId, dayOfWeek, scheduleBlockId, courseId])
  @@unique([timetableId, teacherAssignmentId, dayOfWeek, scheduleBlockId])
  @@index([timetableId, teacherId, dayOfWeek])
  @@index([timetableId, courseId, dayOfWeek])
  @@index([teacherAssignmentId])
  @@index([scheduleBlockId])
  @@index([teacherId])
  @@index([courseId])
  @@map("timetable_slots")
}

model AcademicPlan {
  id                  String             @id @default(uuid())
  teacherAssignmentId String
  academicTermId      String
  title               String             @db.VarChar(200)
  description         String?            @db.VarChar(2000)
  startDate           DateTime?          @db.Date
  endDate             DateTime?          @db.Date
  objectives          String?            @db.Text
  contents            String?            @db.Text
  activities          String?            @db.Text
  resources           String?            @db.Text
  evaluationNotes     String?            @db.Text
  notes               String?            @db.Text
  status              AcademicPlanStatus @default(DRAFT)
  createdByUserId     String
  publishedAt         DateTime?
  publishedByUserId   String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  teacherAssignment   TeacherAssignment  @relation(fields: [teacherAssignmentId], references: [id], onDelete: Restrict)
  academicTerm        AcademicTerm       @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  createdByUser       User               @relation("AcademicPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedByUser     User?              @relation("AcademicPlanPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  units               AcademicUnit[]

  @@index([teacherAssignmentId, status])
  @@index([academicTermId])
  @@map("academic_plans")
}

model AcademicUnit {
  id              String       @id @default(uuid())
  academicPlanId  String
  title           String       @db.VarChar(200)
  description     String?      @db.VarChar(2000)
  objectives      String?      @db.Text
  contents        String?      @db.Text
  activities      String?      @db.Text
  resources       String?      @db.Text
  evaluationNotes String?      @db.Text
  startDate       DateTime?    @db.Date
  endDate         DateTime?    @db.Date
  position        Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  academicPlan    AcademicPlan @relation(fields: [academicPlanId], references: [id], onDelete: Cascade)
  lessonPlans     LessonPlan[]

  @@unique([academicPlanId, position])
  @@index([academicPlanId, position])
  @@map("academic_units")
}

model LessonPlan {
  id                 String         @id @default(uuid())
  academicUnitId     String
  title              String         @db.VarChar(200)
  lessonDate         DateTime       @db.Date
  durationMinutes    Int?
  objectives         String?        @db.Text
  introduction       String?        @db.Text
  development        String?        @db.Text
  closure            String?        @db.Text
  resources          String?        @db.Text
  evaluationStrategy String?        @db.Text
  notes              String?        @db.Text
  position           Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  academicUnit       AcademicUnit   @relation(fields: [academicUnitId], references: [id], onDelete: Cascade)
  classSessions      ClassSession[]

  @@unique([academicUnitId, position])
  @@index([academicUnitId, position])
  @@map("lesson_plans")
}

/// An actual teaching occurrence. Academic context is derived from its TeacherAssignment.
model ClassSession {
  id                  String                         @id @default(uuid())
  teacherAssignmentId String
  lessonPlanId        String?
  status              ClassSessionStatus             @default(SCHEDULED)
  scheduledDate       DateTime?                      @db.Date
  occurredOn          DateTime?                      @db.Date
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  teacherAssignment   TeacherAssignment              @relation(fields: [teacherAssignmentId], references: [id], onDelete: Restrict)
  lessonPlan          LessonPlan?                    @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)
  attendanceRecords   ClassSessionAttendanceRecord[]

  @@index([teacherAssignmentId, scheduledDate])
  @@index([teacherAssignmentId, occurredOn])
  @@index([lessonPlanId])
  @@map("class_sessions")
}

/// Student enrollment in a classroom course for an academic period (historical status tracked).
model Enrollment {
  id                            String                         @id @default(uuid())
  studentId                     String
  courseId                      String
  academicPeriodId              String
  enrollmentDate                DateTime                       @db.Date
  status                        EnrollmentStatus               @default(ACTIVE)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  student                       StudentProfile                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course                        Course                         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicPeriod                AcademicPeriod                 @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  grades                        Grade[]
  gradeAuditEvents              GradeAuditEvent[]
  assessmentRosterEntries       AssessmentRosterEntry[]
  attendanceRecords             AttendanceRecord[]
  classSessionAttendanceRecords ClassSessionAttendanceRecord[]

  @@unique([studentId, courseId, academicPeriodId])
  @@index([studentId])
  @@index([courseId])
  @@index([academicPeriodId])
  @@index([status])
  @@index([academicPeriodId, courseId])
  @@map("enrollments")
}

/// Daily course-level attendance. `date` is a school calendar date, not an instant.
model AttendanceRecord {
  id               String                    @id @default(uuid())
  institutionId    String
  academicPeriodId String
  courseId         String
  enrollmentId     String
  date             DateTime                  @db.Date
  status           AttendanceStatus
  notes            String?                   @db.VarChar(500)
  recordedByUserId String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  institution      Institution               @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  academicPeriod   AcademicPeriod            @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  course           Course                    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment       Enrollment                @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  recordedByUser   User                      @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  justifications   AttendanceJustification[]

  @@unique([enrollmentId, date])
  @@index([institutionId, date])
  @@index([academicPeriodId, courseId, date])
  @@index([courseId, date])
  @@index([recordedByUserId])
  @@map("attendance_records")
}

/// Attendance recorded for one enrolled student at one actual class session.
model ClassSessionAttendanceRecord {
  id               String           @id @default(uuid())
  classSessionId   String
  enrollmentId     String
  status           AttendanceStatus
  note             String?          @db.VarChar(500)
  recordedByUserId String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  classSession     ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  enrollment       Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  recordedByUser   User             @relation("ClassSessionAttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([classSessionId, enrollmentId])
  @@index([enrollmentId])
  @@index([classSessionId, status])
  @@map("class_session_attendance_records")
}

model AttendanceJustification {
  id                 String                        @id @default(uuid())
  attendanceRecordId String
  reason             String                        @db.VarChar(1000)
  status             AttendanceJustificationStatus @default(PENDING)
  submittedByUserId  String
  reviewedByUserId   String?
  reviewedAt         DateTime?
  reviewComment      String?                       @db.VarChar(1000)
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  attendanceRecord   AttendanceRecord              @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  submittedByUser    User                          @relation("AttendanceJustificationSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser     User?                         @relation("AttendanceJustificationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([attendanceRecordId, status])
  @@index([submittedByUserId])
  @@index([reviewedByUserId])
  @@map("attendance_justifications")
}

/// Audit record for academic year transitions — historical data is never mutated.
model AcademicPeriodTransition {
  id                   String         @id @default(uuid())
  institutionId        String
  fromAcademicPeriodId String
  toAcademicPeriodId   String
  executedById         String
  copiedCourses        Boolean        @default(false)
  copiedAssignments    Boolean        @default(false)
  copiedStructures     Boolean        @default(false)
  copiedTerms          Boolean        @default(false)
  createdAt            DateTime       @default(now())
  institution          Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fromPeriod           AcademicPeriod @relation("TransitionFromPeriod", fields: [fromAcademicPeriodId], references: [id], onDelete: Restrict)
  toPeriod             AcademicPeriod @relation("TransitionToPeriod", fields: [toAcademicPeriodId], references: [id], onDelete: Restrict)
  executedBy           User           @relation(fields: [executedById], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([fromAcademicPeriodId])
  @@index([toAcademicPeriodId])
  @@index([executedById])
  @@index([createdAt])
  @@map("academic_period_transitions")
}

// ---------------------------------------------------------------------------
// Academic evaluation configuration — grading engine foundation
// ---------------------------------------------------------------------------
enum RoundingStrategy {
  ROUND_HALF_UP
  ROUND_DOWN
  ROUND_UP
  TRUNCATE
}

enum GradeAuditOperation {
  CREATED
  UPDATED
  CLEARED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
}

/// Numeric grading scale definition (institution-owned or global template).
model GradingScheme {
  id            String   @id @default(uuid())
  institutionId String?
  name          String
  minScore      Decimal  @db.Decimal(6, 2)
  maxScore      Decimal  @db.Decimal(6, 2)
  passingScore  Decimal  @db.Decimal(6, 2)
  decimalPlaces Int      @default(2)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution    Institution?                       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  gradeScales    GradeScale[]
  configurations InstitutionAcademicConfiguration[]
  platformConfig PlatformAcademicEvaluationConfig?
  gradeSnapshots Grade[]

  @@index([institutionId])
  @@index([institutionId, isDefault])
  @@index([isActive])
  @@map("grading_schemes")
}

/// Grading period with weighting — distinct from calendar AcademicTerm (quimesters).
model EvaluationTerm {
  id               String    @id @default(uuid())
  institutionId    String
  academicPeriodId String
  name             String
  order            Int
  weight           Decimal   @db.Decimal(5, 2)
  startDate        DateTime? @db.Date
  endDate          DateTime? @db.Date
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  institution    Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)

  @@unique([institutionId, academicPeriodId, order])
  @@unique([institutionId, academicPeriodId, name])
  @@index([institutionId])
  @@index([academicPeriodId])
  @@index([isActive])
  @@map("evaluation_terms")
}

/// Assessment category with weight for grade composition (e.g. exams, projects).
model AssessmentCategory {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  weight        Decimal  @db.Decimal(5, 2)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([isActive])
  @@map("assessment_categories")
}

/// Qualitative equivalency band within a grading scheme.
model GradeScale {
  id              String   @id @default(uuid())
  gradingSchemeId String
  code            String
  description     String
  minValue        Decimal  @db.Decimal(6, 2)
  maxValue        Decimal  @db.Decimal(6, 2)
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gradingScheme GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)

  @@unique([gradingSchemeId, code])
  @@unique([gradingSchemeId, order])
  @@index([gradingSchemeId])
  @@map("grade_scales")
}

/// Institution-level active evaluation configuration snapshot.
model InstitutionAcademicConfiguration {
  id                     String           @id @default(uuid())
  institutionId          String           @unique
  gradingSchemeId        String
  activeAcademicPeriodId String?
  roundingStrategy       RoundingStrategy @default(ROUND_HALF_UP)
  decimalPlaces          Int              @default(2)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  institution          Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  gradingScheme        GradingScheme   @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)
  activeAcademicPeriod AcademicPeriod? @relation("ConfigActivePeriod", fields: [activeAcademicPeriodId], references: [id], onDelete: SetNull)

  @@index([gradingSchemeId])
  @@index([activeAcademicPeriodId])
  @@map("institution_academic_configurations")
}

/// Singleton platform defaults applied to all institutions unless customized.
model PlatformAcademicEvaluationConfig {
  id               String           @id @default("platform-evaluation-defaults")
  gradingSchemeId  String           @unique
  roundingStrategy RoundingStrategy @default(ROUND_HALF_UP)
  decimalPlaces    Int              @default(2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  gradingScheme GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)

  @@map("platform_academic_evaluation_config")
}

/// Platform-wide assessment category template (copied per institution on apply).
model AssessmentCategoryTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  weight      Decimal  @db.Decimal(5, 2)
  description String?
  order       Int      @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("assessment_category_templates")
}

/// Platform-wide evaluation term template (copied per institution period on apply).
model EvaluationTermTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  order       Int      @unique
  weight      Decimal  @db.Decimal(5, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("evaluation_term_templates")
}

// ---------------------------------------------------------------------------
// Grades — assessments and grade entries (phase 1)
// ---------------------------------------------------------------------------

/// Teacher-created evaluation instrument scoped to an assignment and calendar term.
model Assessment {
  id                   String           @id @default(uuid())
  institutionId        String
  academicPeriodId     String
  academicTermId       String
  subjectId            String
  teacherAssignmentId  String
  assessmentCategoryId String
  title                String
  description          String?
  maxScore             Decimal          @db.Decimal(6, 2)
  weight               Decimal          @db.Decimal(5, 2)
  assessmentDate       DateTime         @db.Date
  status               AssessmentStatus @default(DRAFT)
  publishedAt          DateTime?
  publishedByUserId    String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  institution        Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicPeriod     AcademicPeriod          @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  academicTerm       AcademicTerm            @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  subject            Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherAssignment  TeacherAssignment       @relation(fields: [teacherAssignmentId], references: [id], onDelete: Restrict)
  assessmentCategory AssessmentCategory      @relation(fields: [assessmentCategoryId], references: [id], onDelete: Restrict)
  publishedBy        User?                   @relation("AssessmentPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  grades             Grade[]
  gradeAuditEvents   GradeAuditEvent[]
  rosterEntries      AssessmentRosterEntry[]

  @@index([institutionId])
  @@index([academicPeriodId])
  @@index([academicTermId])
  @@index([subjectId])
  @@index([teacherAssignmentId])
  @@index([assessmentCategoryId])
  @@index([status])
  @@index([publishedByUserId])
  @@index([academicPeriodId, teacherAssignmentId])
  @@index([institutionId, academicPeriodId, academicTermId])
  @@map("assessments")
}

model AssessmentRosterEntry {
  id           String   @id @default(uuid())
  assessmentId String
  enrollmentId String
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, enrollmentId])
  @@index([assessmentId])
  @@index([enrollmentId])
  @@map("assessment_roster_entries")
}

/// Score recorded for a student enrollment on a specific assessment.
model Grade {
  id              String   @id @default(uuid())
  assessmentId    String
  enrollmentId    String
  score           Decimal  @db.Decimal(6, 2)
  observations    String?
  gradingSchemeId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assessment    Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  enrollment    Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  gradingScheme GradingScheme? @relation(fields: [gradingSchemeId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, enrollmentId])
  @@index([assessmentId])
  @@index([enrollmentId])
  @@index([gradingSchemeId])
  @@map("grades")
}

/// Append-only history for grade state changes. It references the durable
/// assessment/enrollment identity rather than a Grade row that can be cleared.
model GradeAuditEvent {
  id                   String              @id @default(uuid())
  assessmentId         String
  enrollmentId         String
  actorId              String
  operation            GradeAuditOperation
  previousScore        Decimal?            @db.Decimal(6, 2)
  newScore             Decimal?            @db.Decimal(6, 2)
  previousObservations String?
  newObservations      String?
  reason               String?
  createdAt            DateTime            @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  actor      User       @relation("GradeAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([assessmentId])
  @@index([enrollmentId])
  @@index([actorId])
  @@index([createdAt])
  @@map("grade_audit_events")
}

// Bootstrap health probe — kept for infrastructure checks.
model HealthCheck {
  id        Int      @id @default(1)
  checkedAt DateTime @default(now()) @updatedAt
}
