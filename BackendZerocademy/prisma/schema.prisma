// Prisma schema — persistence layer for BackendZerocademy.
// DATABASE_URL is injected by Docker Compose / .env (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Bootstrap model so migrations and prisma generate work in Docker.
// Replace with domain models as features are implemented.
model HealthCheck {
  id        Int      @id @default(1)
  checkedAt DateTime @default(now()) @updatedAt
}
