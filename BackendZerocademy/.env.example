# Local development (without Docker). Copy to BackendZerocademy/.env
PORT=3001
# App runtime (Neon: prefer the pooled URL with -pooler in the hostname)
DATABASE_URL=postgresql://zerocademy:zerocademy_secret@localhost:5432/zerocademy_db?schema=public
# Prisma CLI / migrations (Neon: direct URL without -pooler; local: same as DATABASE_URL)
DATABASE_URL_UNPOOLED=postgresql://zerocademy:zerocademy_secret@localhost:5432/zerocademy_db?schema=public
JWT_SECRET=change-me-in-production-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Comma-separated list. In development, private LAN IPs on any port are also allowed.
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Log SQL queries to stdout (default: on in development, off in production)
# PRISMA_LOG_QUERIES=true
SWAGGER_ENABLED=
SEED_ADMIN_EMAIL=admin@zerocademy.edu
SEED_ADMIN_PASSWORD=ChangeMe123!
# Skip demo institution (catalog + SUPER_ADMIN only)
# SEED_SKIP_DEMO=true
