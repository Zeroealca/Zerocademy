# Local development (without Docker). Copy to BackendZerocademy/.env
PORT=3001
DATABASE_URL=postgresql://zerocademy:zerocademy_secret@localhost:5432/zerocademy_db?schema=public
JWT_SECRET=change-me-in-production-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
SWAGGER_ENABLED=
SEED_ADMIN_EMAIL=admin@zerocademy.edu
SEED_ADMIN_PASSWORD=ChangeMe123!
